PORT=3000
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
CORS_ORIGIN=http://localhost:4200,https://nano-clean-app.vercel.app
APP_PUBLIC_URL=https://nano-clean-app.vercel.app

# Integracion de notificaciones automaticas por WhatsApp (Evolution API, UltraMsg o Webhook generico)
# Ejemplos de WHATSAPP_WEBHOOK_URL:
#   Evolution API: https://evo.tudominio.com/message/sendText/nanoclean
#   UltraMsg:      https://api.ultramsg.com/instanceXXXX/messages/chat
#   Webhook n8n:   https://n8n.tudominio.com/webhook/nanoclean-whatsapp
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_KEY=
# Opcional: evolution | ultramsg | generic (se detecta automatico desde la URL si se omite)
WHATSAPP_PROVIDER=
# Opcional: true para enviar tambien confirmacion al marcar como entregado (por defecto solo recibido y listo)
WHATSAPP_NOTIFY_DELIVERED=false
